# SCANHEXA - Environment Configuration Example
# Instructions: Copy this file to .env and fill in the values.

# Server Configuration
PORT=3000
NODE_ENV=development

# Security & Authentication
# Note: Hash your admin password using the provided security scripts.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=a_very_long_random_string_here

# API Integrations (Optional)
# Get your keys from: https://shodan.io
SHODAN_API_KEY=
# Get your keys from: https://ipinfo.io
IPINFO_API_KEY=

# App Metadata
API_KEY=your_generic_api_key_here
